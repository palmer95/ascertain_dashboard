# Copy to .env and adjust as needed:  cp .env.example .env
# Every value has a working default, so .env is optional for both `docker compose up` and
# local development.

# --- PostgreSQL ---
# Used by the db container and by the backend (which builds its connection URL from them).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ascertain
# Host port the database is published on (5433 avoids clashing with a local Postgres).
POSTGRES_PORT=5433

# --- Published ports (docker compose) ---
# The app: http://localhost:8080
FRONTEND_PORT=8080
# The API and its docs: http://localhost:8000/docs
BACKEND_PORT=8000

# --- Backend ---
LOG_LEVEL=INFO
# The practice's IANA time zone. Dates (ages, the day a note was taken) and times in the app
# follow the clinic's clock, wherever the server or the viewer is.
CLINIC_TIMEZONE=America/New_York

# --- Patient summaries (optional) ---
# With a key, the summary narrative is written by Claude; without one, a template is used.
# Real PHI must not be sent to a third-party LLM without a signed BAA (the seed data is synthetic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
