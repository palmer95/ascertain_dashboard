{
  "openapi": "3.1.0",
  "info": {
    "title": "Ascertain Healthcare API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "Report that the API process is up and serving requests.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients": {
      "get": {
        "tags": [
          "patients"
        ],
        "summary": "List patients",
        "description": "Paginated, server-side search, filter and sort, so the client only ever loads one page.",
        "operationId": "list_patients",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive name search. Every word must match the first or last name, so \"jane doe\" and \"doe, jane\" both work.",
              "title": "Q"
            },
            "description": "Case-insensitive name search. Every word must match the first or last name, so \"jane doe\" and \"doe, jane\" both work."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PatientStatus"
              },
              "maxItems": 4,
              "default": [],
              "title": "Status"
            }
          },
          {
            "name": "blood_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/BloodType"
              },
              "maxItems": 8,
              "default": [],
              "title": "Blood Type"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 62,
              "description": "2-letter US state codes.",
              "default": [],
              "title": "State"
            },
            "description": "2-letter US state codes."
          },
          {
            "name": "min_age",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 130,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Age in years.",
              "title": "Min Age"
            },
            "description": "Age in years."
          },
          {
            "name": "max_age",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 130,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Age in years, inclusive. Set both to the same value for an exact age.",
              "title": "Max Age"
            },
            "description": "Age in years, inclusive. Set both to the same value for an exact age."
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive text in any of the patient's conditions, e.g. \"diabetes\".",
              "title": "Condition"
            },
            "description": "Case-insensitive text in any of the patient's conditions, e.g. \"diabetes\"."
          },
          {
            "name": "allergy",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive text in any of the patient's allergies, e.g. \"penicillin\".",
              "title": "Allergy"
            },
            "description": "Case-insensitive text in any of the patient's allergies, e.g. \"penicillin\"."
          },
          {
            "name": "last_visit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/LastVisit"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the patient was last seen. A year is 365 days.",
              "title": "Last Visit"
            },
            "description": "When the patient was last seen. A year is 365 days."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PatientSort",
              "default": "name"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "default": "asc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "patients"
        ],
        "summary": "Create a patient",
        "operationId": "create_patient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRead"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (e.g. invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/{patient_id}": {
      "get": {
        "tags": [
          "patients"
        ],
        "summary": "Get a patient",
        "operationId": "get_patient",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRead"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "patients"
        ],
        "summary": "Replace a patient",
        "description": "Full replacement: send every field. Omitted optional fields are cleared.",
        "operationId": "update_patient",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRead"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (e.g. invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "patients"
        ],
        "summary": "Delete a patient",
        "operationId": "delete_patient",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/{patient_id}/notes": {
      "get": {
        "tags": [
          "notes"
        ],
        "summary": "List a patient's notes",
        "description": "Newest first, by the note's clinical time (`taken_at`).",
        "operationId": "list_notes",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NoteRead"
                  },
                  "title": "Response List Notes"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "notes"
        ],
        "summary": "Add a note",
        "operationId": "create_note",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteRead"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (e.g. invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/{patient_id}/notes/{note_id}": {
      "delete": {
        "tags": [
          "notes"
        ],
        "summary": "Delete a note",
        "description": "404 if the note doesn't exist or belongs to a different patient.",
        "operationId": "delete_note",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Note Id"
            }
          },
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/{patient_id}/summary": {
      "get": {
        "tags": [
          "summary"
        ],
        "summary": "Get a patient summary",
        "description": "Key facts from the record plus a narrative of the clinical notes.\n\nThe narrative is written by Claude when `ANTHROPIC_API_KEY` is set, and by a template\notherwise (or if the model call fails); `source` says which.",
        "operationId": "get_patient_summary",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientSummary"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/stats": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Dashboard statistics",
        "description": "Patient counts by status and recent visit activity, for the dashboard home page.",
        "operationId": "get_dashboard_stats",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardStats"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BloodType": {
        "type": "string",
        "enum": [
          "A+",
          "A-",
          "B+",
          "B-",
          "AB+",
          "AB-",
          "O+",
          "O-"
        ],
        "title": "BloodType"
      },
      "DashboardStats": {
        "properties": {
          "total_patients": {
            "type": "integer",
            "title": "Total Patients"
          },
          "by_status": {
            "items": {
              "$ref": "#/components/schemas/StatusCount"
            },
            "type": "array",
            "title": "By Status",
            "description": "Every status in a fixed order, including those with zero patients."
          },
          "visits_last_30_days": {
            "type": "integer",
            "title": "Visits Last 30 Days",
            "description": "Patients whose most recent visit was in the last 30 days."
          },
          "recent_visits": {
            "items": {
              "$ref": "#/components/schemas/RecentVisit"
            },
            "type": "array",
            "title": "Recent Visits",
            "description": "The most recently seen patients."
          }
        },
        "type": "object",
        "required": [
          "total_patients",
          "by_status",
          "visits_last_30_days",
          "recent_visits"
        ],
        "title": "DashboardStats"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable, machine-readable error code.",
            "examples": [
              "validation_error"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable summary.",
            "examples": [
              "Request validation failed"
            ]
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Dotted path to the offending field (e.g. `allergies.0`), or null.",
            "examples": [
              "date_of_birth"
            ]
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "examples": [
              "Date of birth cannot be in the future"
            ]
          }
        },
        "type": "object",
        "required": [
          "field",
          "msg"
        ],
        "title": "ErrorDetail",
        "description": "A single problem with the request, tied to a field when one applies."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Envelope returned for every non-2xx response."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LastVisit": {
        "type": "string",
        "enum": [
          "within_30_days",
          "within_90_days",
          "within_1_year",
          "over_1_year",
          "never"
        ],
        "title": "LastVisit",
        "description": "Preset ranges for when a patient was last seen."
      },
      "NoteCreate": {
        "properties": {
          "taken_at": {
            "type": "string",
            "format": "date-time",
            "title": "Taken At",
            "description": "When the note was taken (clinical time), with a timezone offset."
          },
          "content": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taken_at",
          "content"
        ],
        "title": "NoteCreate"
      },
      "NoteRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "patient_id": {
            "type": "string",
            "format": "uuid",
            "title": "Patient Id"
          },
          "taken_at": {
            "type": "string",
            "format": "date-time",
            "title": "Taken At"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "taken_at",
          "content",
          "created_at"
        ],
        "title": "NoteRead"
      },
      "PatientCreate": {
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Last Name"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "title": "Date Of Birth"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "title": "Phone"
          },
          "address_line1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Address Line1"
          },
          "address_line2": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Line2"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State",
            "examples": [
              "CA"
            ]
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code",
            "examples": [
              "94107"
            ]
          },
          "blood_type": {
            "$ref": "#/components/schemas/BloodType"
          },
          "status": {
            "$ref": "#/components/schemas/PatientStatus"
          },
          "allergies": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 50,
            "title": "Allergies",
            "examples": [
              [
                "Penicillin"
              ]
            ]
          },
          "conditions": {
            "items": {
