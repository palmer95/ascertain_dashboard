{
  "openapi": "3.1.0",
  "info": {
    "title": "Ascertain Healthcare API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "Report that the API process is up and serving requests.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients": {
      "get": {
        "tags": [
          "patients"
        ],
        "summary": "List patients",
        "description": "Paginated, server-side search, filter and sort, so the client only ever loads one page.",
        "operationId": "list_patients",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive name search. Every word must match the first or last name, so \"jane doe\" and \"doe, jane\" both work.",
              "title": "Q"
            },
            "description": "Case-insensitive name search. Every word must match the first or last name, so \"jane doe\" and \"doe, jane\" both work."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PatientStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PatientSort",
              "default": "name"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "default": "asc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "patients"
        ],
        "summary": "Create a patient",
        "operationId": "create_patient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRead"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (e.g. invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/{patient_id}": {
      "get": {
        "tags": [
          "patients"
        ],
        "summary": "Get a patient",
        "operationId": "get_patient",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRead"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "patients"
        ],
        "summary": "Replace a patient",
        "description": "Full replacement: send every field. Omitted optional fields are cleared.",
        "operationId": "update_patient",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientRead"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (e.g. invalid JSON)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "patients"
        ],
        "summary": "Delete a patient",
        "operationId": "delete_patient",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BloodType": {
        "type": "string",
        "enum": [
          "A+",
          "A-",
          "B+",
          "B-",
          "AB+",
          "AB-",
          "O+",
          "O-"
        ],
        "title": "BloodType"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable, machine-readable error code.",
            "examples": [
              "validation_error"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable summary.",
            "examples": [
              "Request validation failed"
            ]
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Dotted path to the offending field (e.g. `allergies.0`), or null.",
            "examples": [
              "date_of_birth"
            ]
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "examples": [
              "Date of birth cannot be in the future"
            ]
          }
        },
        "type": "object",
        "required": [
          "field",
          "msg"
        ],
        "title": "ErrorDetail",
        "description": "A single problem with the request, tied to a field when one applies."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Envelope returned for every non-2xx response."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "PatientCreate": {
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Last Name"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "title": "Date Of Birth"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "title": "Phone"
          },
          "address_line1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Address Line1"
          },
          "address_line2": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Line2"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State",
            "examples": [
              "CA"
            ]
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code",
            "examples": [
              "94107"
            ]
          },
          "blood_type": {
            "$ref": "#/components/schemas/BloodType"
          },
          "status": {
            "$ref": "#/components/schemas/PatientStatus"
          },
          "allergies": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 50,
            "title": "Allergies",
            "examples": [
              [
                "Penicillin"
              ]
            ]
          },
          "conditions": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 50,
            "title": "Conditions",
            "examples": [
              [
                "Hypertension"
              ]
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "date_of_birth",
          "phone",
          "address_line1",
          "city",
          "state",
          "postal_code",
          "blood_type",
          "status"
        ],
        "title": "PatientCreate",
        "description": "Body for `POST /patients`."
      },
      "PatientPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PatientRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Matching patients across all pages."
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "PatientPage"
      },
      "PatientRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "first_name": {
            "type": "string",
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "title": "Date Of Birth"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "address_line1": {
            "type": "string",
            "title": "Address Line1"
          },
          "address_line2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Line2"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code"
          },
          "blood_type": {
            "$ref": "#/components/schemas/BloodType"
          },
          "status": {
            "$ref": "#/components/schemas/PatientStatus"
          },
          "allergies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allergies"
          },
          "conditions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Conditions"
          },
          "last_visit_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Visit At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "age": {
            "type": "integer",
            "title": "Age",
            "description": "Derived from date_of_birth on every read; never stored, so it can't go stale.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "first_name",
          "last_name",
          "date_of_birth",
          "email",
          "phone",
          "address_line1",
          "address_line2",
          "city",
          "state",
          "postal_code",
          "blood_type",
          "status",
          "allergies",
          "conditions",
          "last_visit_at",
          "created_at",
          "updated_at",
          "age"
        ],
        "title": "PatientRead"
      },
      "PatientSort": {
        "type": "string",
        "enum": [
          "name",
          "age",
          "last_visit_at",
          "status"
        ],
        "title": "PatientSort"
      },
      "PatientStatus": {
        "type": "string",
        "enum": [
          "active",
          "inactive",
          "pending",
          "discharged"
        ],
        "title": "PatientStatus",
        "description": "Administrative status. Clinical acuity is intentionally a separate concept."
      },
      "PatientUpdate": {
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "First Name"
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Last Name"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "title": "Date Of Birth"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "title": "Phone"
          },
          "address_line1": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Address Line1"
          },
          "address_line2": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Line2"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State",
            "examples": [
              "CA"
            ]
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code",
            "examples": [
              "94107"
            ]
          },
          "blood_type": {
            "$ref": "#/components/schemas/BloodType"
          },
          "status": {
            "$ref": "#/components/schemas/PatientStatus"
          },
          "allergies": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 50,
            "title": "Allergies",
            "examples": [
              [
                "Penicillin"
              ]
            ]
          },
          "conditions": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 50,
            "title": "Conditions",
            "examples": [
              [
                "Hypertension"
              ]
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "date_of_birth",
          "phone",
          "address_line1",
          "city",
          "state",
          "postal_code",
          "blood_type",
          "status"
        ],
        "title": "PatientUpdate",
        "description": "Body for `PUT /patients/{id}`: a full replacement, so every required field is sent."
      },
      "SortOrder": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "SortOrder"
      }
    }
  }
}
